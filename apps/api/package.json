{
  "name": "@reviesnest/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts",
    "admin:provision": "tsx src/provision-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@reviesnest/contracts": "*",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.15",
    "pino": "^10.0.0",
    "zod": "^4.3.0",
    "@reviesnest/google-business": "*",
    "bullmq": "^5.70.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.2.0",
    "tsx": "^4.21.0"
  }
}
