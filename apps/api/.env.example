NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=mysql://reviesnest:local-dev-only@127.0.0.1:13307/reviesnest
REDIS_URL=redis://127.0.0.1:16380

# Configure all three together; never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Limits are captured when a trial is created; existing grants never reset.
TRIAL_AI_ALLOWANCE=20
BASIC_MONTHLY_PRICE_INR=99
PAID_AI_ALLOWANCE=30

# Separate Business Profile OAuth callback; register this exact URI in Google Cloud.
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:3000/api/google-business/callback
# Generate once: openssl rand -base64 32. Share securely with worker; retain for decryption.
# TOKEN_ENCRYPTION_KEY=
